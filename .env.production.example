# ============================================================
# Üretim ortamı değişkenleri — `./blog deploy` bu dosyadan
# `.env.production` üretir ve tüm secret'ları rastgele doldurur.
# Elle kuruyorsanız: cp .env.production.example .env.production
# ve boş değerleri doldurun (secret üretmek için: openssl rand -hex 32).
# ============================================================

# "caddy" → Caddy 80/443'te otomatik HTTPS sağlar (önerilen).
# Boş bırakılırsa Caddy başlatılmaz; kendi reverse proxy'nizi
# 127.0.0.1:3000 (web) ve 127.0.0.1:1337 (cms) adreslerine yönlendirin.
COMPOSE_PROFILES=caddy

# Alan adları — ikisinin de DNS A kaydı sunucu IP'sini göstermeli.
DOMAIN=blog.example.com
CMS_DOMAIN=cms.blog.example.com
# Strapi'nin dışarıdan görünen adresi (şifre sıfırlama e-postaları vb.)
CMS_URL=https://cms.blog.example.com

# PostgreSQL (container içi; dışarı açılmaz)
POSTGRES_DB=blog
POSTGRES_USER=blog
POSTGRES_PASSWORD=

# Strapi gizli anahtarları
APP_KEYS=
API_TOKEN_SALT=
ADMIN_JWT_SECRET=
TRANSFER_TOKEN_SALT=
JWT_SECRET=
ENCRYPTION_KEY=

# Next.js on-demand revalidation (POST /api/revalidate)
REVALIDATE_SECRET=

# İsteğe bağlı: Strapi API token'ı (Settings → API Tokens)
STRAPI_API_TOKEN=

# Yalnızca 127.0.0.1'e bağlanan portlar (kendi proxy'nizi kullanırken)
WEB_PORT=3000
CMS_PORT=1337
