{
  "name": "blog-monorepo",
  "version": "0.0.1",
  "type": "module",
  "private": true,
  "packageManager": "pnpm@10.8.1",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "bootstrap": "sh blog setup",
    "dev": "pnpm --parallel --filter \"./apps/*\" dev",
    "dev:web": "pnpm --filter web dev",
    "dev:cms": "pnpm --filter cms develop",
    "dev:cms:start": "pnpm --filter cms build && pnpm --filter cms start",
    "dev:light": "pnpm --filter cms build && sh -c 'trap \"kill 0\" INT TERM; pnpm --filter cms start & pnpm --filter web dev & wait'",
    "build": "pnpm --recursive --filter \"./apps/*\" build",
    "build:web": "pnpm --filter web build",
    "build:cms": "pnpm --filter cms build",
    "start:web": "pnpm --filter web start",
    "start:cms": "pnpm --filter cms start",
    "db:generate": "pnpm --filter @repo/db db:generate",
    "db:migrate": "pnpm --filter @repo/db db:migrate",
    "db:push": "pnpm --filter @repo/db db:push",
    "db:studio": "pnpm --filter @repo/db db:studio",
    "lint": "pnpm --recursive lint",
    "typecheck": "pnpm --recursive typecheck",
    "format": "prettier --write \"**/*.{ts,tsx,md}\"",
    "docker:up": "sh blog dev",
    "docker:down": "sh blog stop --dev",
    "docker:logs": "sh blog logs --dev",
    "docker:reset": "sh blog reset --dev",
    "docker:reset:deps": "docker compose down && docker volume rm blog_dev_node_modules blog_dev_pnpm_store",
    "docker:prod:up": "sh blog deploy",
    "docker:prod:down": "sh blog stop --prod",
    "docker:prod:logs": "sh blog logs --prod",
    "backup": "sh blog backup"
  },
  "devDependencies": {
    "prettier": "^3.8.3",
    "prettier-plugin-tailwindcss": "^0.8.0"
  }
}
